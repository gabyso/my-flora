{
  "extends": ["expo/tsconfig.base", "../../packages/config/typescript/react-native.json"],
  "compilerOptions": {
    "paths": {
      "@mobile/*": ["./src/*"]
    },
    "types": ["nativewind/types", "vitest/globals"]
  },
  "include": [
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
